#!/usr/bin/env bash
# tries-root: print the folder that holds the dated try folders.
# First hit wins: $GRADUATE_TRIES_ROOT, the cwd of existing herdr spaces that
# are tries, $TRY_PATH or `try init <root>` in a shell rc, ~/Work/tries,
# ~/src/tries. A candidate counts only if it holds a YYYY-MM-DD-* folder.
# GRADUATE_SKIP_HERDR=1 skips the herdr lookup (for tests).
set -uo pipefail
has_tries() { compgen -G "$1/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*" >/dev/null; }
pick() { [[ -n $1 && -d $1 ]] && has_tries "$1" && { readlink -f "$1"; exit 0; }; }

pick "${GRADUATE_TRIES_ROOT:-}"
if [[ -z ${GRADUATE_SKIP_HERDR:-} ]] && command -v herdr >/dev/null; then
  while read -r r; do pick "$r"; done < <(herdr api snapshot 2>/dev/null |
    jq -r '.. | objects | select(has("cwd") and has("pane_id")) | .cwd' 2>/dev/null |
    grep -oP '.*/tries(?=/\d{4}-\d{2}-\d{2}-)' | sort | uniq -c | sort -rn | awk '{print $2}')
fi
pick "${TRY_PATH:-}"
for rc in ~/.bashrc ~/.zshrc ~/.profile ~/.config/fish/config.fish; do
  [[ -f $rc ]] || continue
  r=$(grep -oP 'try init\s+\K[^)"'"'"'\s]+' "$rc" | head -1)
  pick "${r/#\~/$HOME}"
done
pick ~/Work/tries
pick ~/src/tries
echo "tries-root: no folder with YYYY-MM-DD-* tries found; ask the user where tries live" >&2
exit 1
