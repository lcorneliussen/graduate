#!/usr/bin/env bash
# where: which machine this runs on, which machine drives it, and which stage
# the folder is (emigrated, try, project or conversation).
#   where [folder]      default: the current folder
set -uo pipefail
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
dir=$(readlink -f "${1:-$PWD}")
host=$(hostname)

# The driving machine: the SSH peer, named through tailscale when it can be.
peer="this machine (no SSH session)"
if [[ -n ${SSH_CONNECTION:-} ]]; then
  ip=${SSH_CONNECTION%% *}
  name=$(tailscale status --json 2>/dev/null |
    jq -r --arg ip "$ip" '[.Peer[]?, .Self] | map(select(.TailscaleIPs | index($ip))) | .[0].HostName // empty' 2>/dev/null)
  peer=${name:-$ip}
fi

stage=conversation
detail="not a try or a project"
log=${GRADUATE_EMIGRATED_LOG:-$HOME/Work/emigrated.jsonl}
if [[ -f $log ]]; then
  hit=$(jq -c --arg d "$dir" 'select(.from as $f | $d == $f or ($d | startswith($f + "/")))' "$log" 2>/dev/null | tail -1)
  if [[ -n $hit ]]; then
    stage=emigrated
    detail=$(jq -r '"moved to \(.to_machine):\(.to_path) on \(.date); do not work here"' <<<"$hit")
  fi
fi
if [[ $stage == conversation ]]; then
  root=$("$here/tries-root" 2>/dev/null) || root=""
  if [[ -n $root && $dir == "$root"/* ]]; then
    rel=${dir#"$root"/}
    if [[ ${rel%%/*} =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}- ]]; then
      stage=try
      detail="$root/${rel%%/*}"
    fi
  fi
fi
if [[ $stage == conversation ]] && top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null); then
  stage=project
  detail="$top ($(git -C "$top" branch --show-current 2>/dev/null || echo detached))"
fi

echo "on $host, driven from $peer"
echo "folder: $dir"
echo "stage:  $stage: $detail"
